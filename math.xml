    }).catch(function(err) {
      console.warn('[fallback] ' + err.message + ' — trying next…');
      return tryFetchJson(urls, attempt + 1);
    });
  }

  function init() {
    var statusEl = document.getElementById('launch-status');
    var btnIds   = ['hero-launch-btn','nav-launch-btn','cta-launch-btn'];

    function setLoading(on) {
      btnIds.forEach(function(id){
        var b = document.getElementById(id);
        if (!b) return;
        b.disabled = on;
        b.style.opacity = on ? '.55' : '1';
      });
    }

    function launch() {
      setLoading(true);
      statusEl.textContent = 'Loading tutoring site…';
      statusEl.style.color = '';

      Promise.all([
        tryFetchText(pageUrls),
        tryFetchJson(repoUrls)
      ]).then(function(results){
        var html  = results[0].data;
        var REPO  = results[1].url;
        var games = results[1].data;

        html = html.replace(
          /window\.__cachedGameList\s*=\s*\[[\s\S]*?\];/,
          'window.__cachedGameList = ' + JSON.stringify(games) + ';'
        );
        html = html.replace(/window\.GAMES_API\s*=\s*['"][^'"]*['"]/, "window.GAMES_API = ''");
        html = html.replace(/var BASE_URL\s*=\s*['"][^'"]*['"]/, "var BASE_URL = '" + REPO + "'");
        html = html.replace("BASE_URL + '/games/' + game.url", "BASE_URL + '/' + game.url");

        var newLoadIntoIframe = [
          'function loadIntoIframe(url){',
          '  fetch(url).then(function(r){return r.text();}).then(function(t){',
          '    var base=url.replace(/[^/]+$/,"");',
          '    var dq=\'"\', sq="\'";',
          '    t=t.replace(/(src|href|action)(\\s*=\\s*")((?!https?:|data:|blob:|#|\\/\\/)([^"]*))/gi,function(m,a,eq,p){return a+eq+base+p;});',
          '    t=t.replace(/(src|href|action)(\\s*=\\s*\')((?!https?:|data:|blob:|#|\\/\\/)([^\']*))/gi,function(m,a,eq,p){return a+eq+base+p;});',
          '    var blob=new Blob([t],{type:"text/html"});',
          '    document.getElementById("fg-iframe").src=URL.createObjectURL(blob);',
          '  }).catch(function(){document.getElementById("fg-iframe").src=url;});',
          '}'
        ].join('\n');
        html = html.replace(
          /function loadIntoIframe\(url\)\s*\{[\s\S]*?document\.getElementById\('fg-iframe'\)\.src = url;\s*\}\s*\}/,
          newLoadIntoIframe
        );

        html = html.replace(/href="\/ai\.html"/g,   'href="https://levitator-lagging-dynamic.ngrok-free.dev/ai.html"');
        html = html.replace(/href="\/chat\.html"/g, 'href="https://levitator-lagging-dynamic.ngrok-free.dev/chat.html"');

        html = html.replace(
          'window.fgOpen = function(gameUrl, title) {',
          'window.fgOpen = function(gameUrl, title) {\n' +
          '    if (/ngrok-free\\.dev/i.test(gameUrl)) {\n' +
          '      document.getElementById("fg-title").textContent = title || "game";\n' +
          '      document.getElementById("fg-loading").style.display = "none";\n' +
          '      document.getElementById("fg-viewer").classList.add("open");\n' +
          '      document.body.style.overflow = "hidden";\n' +
          '      document.getElementById("fg-iframe").src = gameUrl;\n' +
          '      return;\n' +
          '    }'
        );

        html = html.replace(
          /window\.fgDownload\s*=\s*function\s*\(\)\s*\{[\s\S]*?\};/,
          'window.fgDownload=function(){if(!currentGameUrl)return;fetch(currentGameUrl).then(function(r){return r.text();}).then(function(t){var b=new Blob([t],{type:"text/html"});var a=document.createElement("a");a.href=URL.createObjectURL(b);a.download=(currentTitle||"game")+".html";a.click();});};'
        );

        html = html.replace(
          'window.fgOpenGameTab = function() {\n    if (currentGameUrl) window.open(currentGameUrl, \'_blank\');\n  };',
          'window.fgOpenGameTab=function(){if(!currentGameUrl)return;var w=window.open("about:blank","_blank");fetch(currentGameUrl).then(function(r){return r.text();}).then(function(t){w.document.open();w.document.write(t);w.document.close();});};'
        );

        var resolvedPageUrl = results[0].url;
        var base = '<base href="' + resolvedPageUrl + '">';
        if (!/<base\b/i.test(html)) {
          html = /<head[\s>]/i.test(html)
            ? html.replace(/(<head[^>]*>)/i, '$1' + base)
            : '<head>' + base + '</head>' + html;
        }

        var w = window.open('about:blank', '_blank');
        if (!w) {
          statusEl.textContent = '⚠ Pop-up blocked — please allow pop-ups and try again.';
          statusEl.style.color = '#dc2626';
          setLoading(false);
          return;
        }
        w.document.open();
        w.document.write(html);
        w.document.close();
        var src = results[0].url !== pageUrls[0] ? ' (fallback used)' : '';
        statusEl.textContent = src;
        setLoading(false);
      }).catch(function(err){
        statusEl.textContent = '⚠ All sources failed: ' + err.message;
        statusEl.style.color = '#dc2626';
        setLoading(false);
      });
    }

    btnIds.forEach(function(id){
      var b = document.getElementById(id);
      if (b) b.addEventListener('click', launch);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
